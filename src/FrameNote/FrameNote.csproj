<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationIcon>Assets/FrameNote.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Platform>x64</Platform><PlatformTarget>x64</PlatformTarget><Version>0.9.6</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Locales/en.json" LogicalName="FrameNote.en.json" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <Resource Include="Assets/FrameNote.ico"/>
    <Content Include="Assets/FrameNote_File.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/releases/v*.md" Link="releases/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="UpdateCheck" />
    <InternalsVisibleTo Include="ReviewStartupCheck" />
    <InternalsVisibleTo Include="CaptureCheck" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
    <Content Include="ui/**/*;reaper/*.lua" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="ui/**/*" Exclude="ui/fonts/**/*">
      <LogicalName>FrameNote.Recovery/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NEbml" Version="1.1.1.10" />
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>
  <!-- A second apphost gives Explorer a distinct executable identity.
       Both hosts load FrameNote.dll and share the same runtime and media tools. -->
  <Target Name="BuildPlayerHost" AfterTargets="Build" Condition="'$(UseAppHost)' == 'true'">
    <Copy SourceFiles="$(TargetDir)FrameNote.exe" DestinationFiles="$(TargetDir)FrameNote Player.exe" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishPlayerHost" AfterTargets="Publish" Condition="'$(UseAppHost)' == 'true'">
    <Copy SourceFiles="$(PublishDir)/FrameNote.exe" DestinationFiles="$(PublishDir)/FrameNote Player.exe" SkipUnchangedFiles="true" />
  </Target>
</Project>


