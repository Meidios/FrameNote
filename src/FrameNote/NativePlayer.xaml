<UserControl x:Class="FrameNote.NativePlayer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:i18n="clr-namespace:FrameNote"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FrameNote" Background="{DynamicResource bg}" Foreground="{DynamicResource ink}" FontFamily="{DynamicResource UiFont}" Focusable="True">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="TransportIcons.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="4,0"/></Style>
   <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="35"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/>
    <Setter Property="ToolTipService.IsEnabled" Value="False"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip,RelativeSource={RelativeSource Self}}"/>
    <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Canvas Width="20" Height="20"><Path Data="{Binding}" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></DataTemplate></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Grid Background="Transparent">
      <Border x:Name="face" CornerRadius="{StaticResource ControlCorners}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" IsHitTestVisible="False"/>
      <local:PointerLight x:Name="light" Margin="1"/>
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="face" Property="Background" Value="{DynamicResource hover}"/><Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource muted}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="face" Property="Background" Value="{DynamicResource pressed}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource disabled}"/><Setter TargetName="face" Property="Background" Value="{DynamicResource bg}"/><Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource edge}"/><Setter TargetName="light" Property="Visibility" Value="Hidden"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid>
 <DockPanel>
  <DockPanel x:Name="Header" DockPanel.Dock="Top" Margin="16,10">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="OpenButton" Content="{i18n:Tr '打开文件'}"/><Button x:Name="ReviewButton" Content="{i18n:Tr '进入批注'}"/></StackPanel>
   <ToggleButton x:Name="PlaylistButton" DockPanel.Dock="Left" Width="34" Height="34" Margin="-8,-4,8,-4" Visibility="Collapsed" FocusVisualStyle="{StaticResource ButtonFocus}"
                 ToolTip="{i18n:Tr '播放列表（Alt+L）'}" ToolTipService.IsEnabled="False" AutomationProperties.Name="{i18n:Tr '播放列表'}" AutomationProperties.AcceleratorKey="Alt+L">
    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
     <Grid Background="Transparent">
      <Border x:Name="face" CornerRadius="{StaticResource ControlCorners}" BorderThickness="1" BorderBrush="{DynamicResource border}" Background="{DynamicResource panel}" Opacity="0.62"/>
      <!-- Lucide ListVideo (ui/icons/LUCIDE-LICENSE.txt), shared design with the image viewer. -->
      <Grid><local:PointerLight/><Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="M3 6H16 M3 12H12 M3 18H12 M16 12L21 15 16 18Z" Stroke="{DynamicResource ink}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Grid>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource accent}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="face" Property="Opacity" Value="1"/><Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource link}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="face" Property="Opacity" Value="1"/><Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource link}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></ToggleButton.Template>
   </ToggleButton>
   <TextBlock x:Name="Caption" FontSize="17" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
  </DockPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="16,8">
   <Slider x:Name="Timeline" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" AutomationProperties.Name="{i18n:Tr '播放位置'}"/>
   <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel x:Name="Shuttle" Orientation="Horizontal" Background="Transparent">
     <Button x:Name="Previous" Style="{StaticResource ToolButton}" Content="{StaticResource previous}" ToolTip="{i18n:Tr '上一帧（←）'}"/>
     <Button x:Name="Toggle" Style="{StaticResource ToolButton}" Content="{StaticResource play}" ToolTip="{i18n:Tr '播放（空格）'}"/>
     <Button x:Name="Next" Style="{StaticResource ToolButton}" Content="{StaticResource next}" ToolTip="{i18n:Tr '下一帧（→）'}"/>
     <TextBlock x:Name="Clock" Typography.NumeralAlignment="Tabular" Margin="7,0" VerticalAlignment="Center"/>
    </StackPanel>
    <Grid Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
     <TextBlock x:Name="Hint" TextTrimming="CharacterEllipsis"/>
     <StackPanel x:Name="MediaLoad" Visibility="Collapsed" MaxWidth="200" HorizontalAlignment="Left">
      <TextBlock x:Name="MediaLoadText"/>
      <ProgressBar x:Name="MediaLoadBar" Style="{x:Null}" Foreground="{DynamicResource accent}" Height="4" MinWidth="120" Margin="0,3,0,0" Maximum="100" AutomationProperties.LabeledBy="{Binding ElementName=MediaLoadText}"/>
     </StackPanel>
    </Grid>
    <StackPanel x:Name="Output" Grid.Column="2" Orientation="Horizontal" Background="Transparent">
     <Button x:Name="CopyFrame" Style="{StaticResource ToolButton}" Content="{StaticResource image_copy}" ToolTip="{i18n:Tr '复制当前帧'}"/>
     <Button x:Name="SaveFrame" Style="{StaticResource ToolButton}" Content="{StaticResource save_image}" ToolTip="{i18n:Tr '另存当前帧为 PNG'}"/>
     <Button x:Name="Mute" Style="{StaticResource ToolButton}" Content="{StaticResource speaker_2}" ToolTip="{i18n:Tr '播放静音'}"/>
     <Button x:Name="Full" Style="{StaticResource ToolButton}" Content="{StaticResource full_screen_maximize}" ToolTip="{i18n:Tr '全屏预览'}"/>
    </StackPanel>
   </Grid>
  </StackPanel>
  <Grid x:Name="VideoArea" ClipToBounds="True" Background="Black">
   <local:VideoSurface x:Name="Surface"/>
   <Grid x:Name="StillViewport" IsHitTestVisible="False"><Image x:Name="Still" Stretch="Uniform" Visibility="Collapsed"/></Grid>
  </Grid>
 </DockPanel>
 <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=Mute}" Placement="Top" AllowsTransparency="True" Focusable="False">
  <Grid x:Name="VolumePopupHost" Width="{Binding ActualWidth,ElementName=Mute}" ClipToBounds="True">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="VolumePercentBadge" Height="20" Margin="0,0,0,4" Visibility="Hidden" IsHitTestVisible="False"
           Background="{DynamicResource panel}" CornerRadius="{StaticResource CompactCorners}">
    <TextBlock x:Name="VolumePercent" FontFamily="{DynamicResource UiFont}" FontSize="12" Typography.NumeralAlignment="Tabular"
               Foreground="{DynamicResource ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <Border Grid.Row="1" Background="#01000000"/>
   <Border Grid.Row="1" x:Name="VolumeCard" Margin="0,0,0,4" Padding="0,9" Background="{DynamicResource card}" BorderBrush="{DynamicResource border}"
           BorderThickness="1" CornerRadius="{StaticResource ControlCorners}" Opacity="0">
    <Border.RenderTransform><TranslateTransform x:Name="VolumeOffset" Y="8"/></Border.RenderTransform>
    <Slider x:Name="VolumeSlider" Width="20" Height="100" Orientation="Vertical" Minimum="0" Maximum="100" TickFrequency="1"
            IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" AutomationProperties.Name="{i18n:Tr '播放音量'}">
     <Slider.Template><ControlTemplate TargetType="Slider">
      <Grid Background="Transparent">
       <Border Margin="0,6" Width="4" CornerRadius="2" Background="{DynamicResource canvas}" BorderBrush="{DynamicResource edge}" BorderThickness="1"/>
       <Track x:Name="PART_Track" Orientation="Vertical">
        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
         <Grid Background="Transparent"><Border Width="4" CornerRadius="2" Background="{DynamicResource accent}"/></Grid>
        </ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb">
         <Grid Background="Transparent"><Ellipse Width="14" Height="14" Fill="{DynamicResource accent}"/></Grid>
        </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Template="{StaticResource ClearRepeat}"/></Track.IncreaseRepeatButton>
       </Track>
      </Grid>
     </ControlTemplate></Slider.Template>
    </Slider>
   </Border>
  </Grid>
 </Popup>
 <Popup x:Name="ButtonHint" Placement="Custom" AllowsTransparency="True" PopupAnimation="{DynamicResource {x:Static SystemParameters.ToolTipPopupAnimationKey}}" Focusable="False" IsHitTestVisible="False">
  <Border Padding="7,2" CornerRadius="{StaticResource CompactCorners}" Background="{DynamicResource panel}" Opacity=".96">
   <TextBlock Text="{Binding PlacementTarget.ToolTip,ElementName=ButtonHint}" FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource ink}" FontSize="12"/>
  </Border>
 </Popup>
 <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="#6B000000">
  <Border x:Name="LoadingCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="344" Padding="24,22,24,20" Background="{DynamicResource panel}" BorderBrush="{DynamicResource border}" BorderThickness="1" CornerRadius="{StaticResource PaneCorners}">
   <StackPanel>
    <DockPanel><TextBlock x:Name="PreviewPercent" DockPanel.Dock="Right" Typography.NumeralAlignment="Tabular" FontSize="14" Foreground="{DynamicResource link}"/><TextBlock x:Name="LoadingTitle" FontSize="14" FontWeight="SemiBold"/></DockPanel>
    <ProgressBar x:Name="PreviewBar" AutomationProperties.LabeledBy="{Binding ElementName=LoadingTitle}" Minimum="0" Maximum="100" Height="8" Margin="0,10,0,0"/>
    <Button x:Name="CancelButton" Content="{i18n:Tr '取消加载'}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
 </Grid>
</UserControl>
