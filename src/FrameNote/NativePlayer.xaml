<UserControl x:Class="FrameNote.NativePlayer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Background="{DynamicResource bg}" Foreground="{DynamicResource ink}" FontFamily="{DynamicResource UiFont}" Focusable="True">
 <UserControl.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="4,0"/></Style>
 </UserControl.Resources>
 <DockPanel>
  <DockPanel DockPanel.Dock="Top" Margin="16,10">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="OpenButton" Content="打开文件"/><Button x:Name="ReviewButton" Content="进入批注"/></StackPanel>
   <TextBlock x:Name="Caption" FontSize="17" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
  </DockPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="16,8">
   <Slider x:Name="Timeline" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" AutomationProperties.Name="播放位置"/>
   <DockPanel Margin="0,6"><Button x:Name="Toggle" DockPanel.Dock="Left" Content="暂停"/>
    <Button x:Name="CancelButton" DockPanel.Dock="Right" Visibility="Collapsed" Content="取消准备"/>
    <TextBlock x:Name="Clock" FontFamily="{DynamicResource MonoFont}" DockPanel.Dock="Left" Margin="8,0" VerticalAlignment="Center"/>
    <TextBlock x:Name="Hint" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
  </StackPanel>
  <vlc:VideoView x:Name="Surface"/>
 </DockPanel>
</UserControl>
