<Window x:Class="FrameNote.RecordingControls" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:i18n="clr-namespace:FrameNote"
 Title="{i18n:Tr 'FrameNote 录制控制'}" WindowStyle="None" ResizeMode="NoResize"
 ShowInTaskbar="False" ShowActivated="False" Focusable="True" Topmost="True"
 Background="Transparent" Width="40" Height="84"
 UseLayoutRounding="True" WindowStartupLocation="Manual">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="TransportIcons.xaml"/></ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>
 <Grid>
  <Button x:Name="PauseButton" Height="{Binding Height, ElementName=StopButton}" VerticalAlignment="Top"
   Visibility="Hidden" IsHitTestVisible="False" Focusable="False" Click="PauseClicked" AutomationProperties.Name="{i18n:Tr '暂停录制'}">
   <Button.RenderTransform><TranslateTransform x:Name="PauseOffset"/></Button.RenderTransform>
   <Path x:Name="PauseIcon" Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource ink}" Data="{StaticResource pause}"/>
  </Button>
  <Button x:Name="StopButton" Height="40" VerticalAlignment="Bottom"
   Focusable="False" Click="StopClicked" AutomationProperties.Name="{i18n:Tr '停止录制'}">
   <Path Width="19" Height="19" Stretch="Uniform" Fill="{DynamicResource danger}" Data="{StaticResource stop}" RenderTransformOrigin="0.5,0.5">
    <Path.RenderTransform><RotateTransform x:Name="StopRotation"/></Path.RenderTransform>
   </Path>
  </Button>
 </Grid>
</Window>
