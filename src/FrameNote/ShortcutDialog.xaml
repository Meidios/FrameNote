<Window x:Class="FrameNote.ShortcutDialog" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:i18n="clr-namespace:FrameNote"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:FrameNote"
 Title="{i18n:Tr '设置'}" Width="820" MinWidth="580" MinHeight="390">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ShortcutIcons.xaml"/></ResourceDictionary.MergedDictionaries>
   <GridLength x:Key="SettingsNavWidth">160</GridLength>
   <Style x:Key="SettingsPane" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource canvas}"/><Setter Property="BorderBrush" Value="{DynamicResource edge}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource PaneCorners}"/>
   </Style>
   <!-- Use the compact action and selector sizes from the main capture panel. -->
   <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinHeight" Value="29"/><Setter Property="Padding" Value="9,4"/>
   </Style>
   <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="MinHeight" Value="31"/>
   </Style>
   <Style x:Key="SettingsIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/>
   </Style>
   <Style x:Key="DirectoryField" TargetType="TextBox">
    <Setter Property="MinHeight" Value="31"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource ink}"/><Setter Property="CaretBrush" Value="{DynamicResource ink}"/>
    <Setter Property="InputMethod.IsInputMethodEnabled" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
     <Border x:Name="face" Padding="7,3" CornerRadius="{StaticResource ControlCorners}" BorderThickness="1" BorderBrush="{DynamicResource border}" Background="{DynamicResource card}">
      <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource link}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource disabled}"/><Setter TargetName="face" Property="Background" Value="{DynamicResource bg}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="SettingsTab" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource ink}"/>
    <Setter Property="FocusVisualStyle"><Setter.Value><Style BasedOn="{StaticResource ButtonFocus}">
     <Setter Property="Control.Margin" Value="0,2"/>
    </Style></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
     <Border x:Name="Tile" Background="Transparent" Padding="13,10" CornerRadius="{StaticResource ControlCorners}" Margin="0,2">
      <StackPanel Orientation="Horizontal">
       <Viewbox Width="17" Height="17" Margin="0,0,10,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{Binding Tag,RelativeSource={RelativeSource TemplatedParent}}" Stroke="{DynamicResource muted}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
       <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
      </StackPanel>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource hover}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource edge}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource muted}"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="Margin" Value="0,4,0,7"/>
   </Style>
   <Style x:Key="SettingsCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource panel}"/><Setter Property="BorderBrush" Value="{DynamicResource edge}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource CardCorners}"/><Setter Property="Padding" Value="16,14"/>
    <Setter Property="Margin" Value="0,0,0,14"/>
   </Style>
   <Style x:Key="ActionRow" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,5"/>
    <Setter Property="Margin" Value="0,0,4,5"/><Setter Property="MinHeight" Value="38"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Face" CornerRadius="{StaticResource ControlCorners}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
      <VisualStateManager.VisualStateGroups>
       <VisualStateGroup x:Name="CommonStates">
        <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.10"/></VisualStateGroup.Transitions>
        <VisualState x:Name="Normal"/>
        <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0.055" Duration="0"/></Storyboard></VisualState>
        <VisualState x:Name="Pressed"/><VisualState x:Name="Disabled"/>
       </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Grid>
       <Border x:Name="Wash" CornerRadius="{StaticResource ControlInnerCorners}" Background="{DynamicResource ink}" Opacity="0" IsHitTestVisible="False"/>
       <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource pressed}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource disabled}"/><Setter TargetName="Face" Property="Background" Value="{DynamicResource bg}"/><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource edge}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="ModifierChip" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource muted}"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="MinWidth" Value="52"/><Setter Property="MinHeight" Value="29"/>
    <Setter Property="Template">
     <Setter.Value><ControlTemplate TargetType="CheckBox">
      <Border x:Name="Face" CornerRadius="{StaticResource ControlCorners}" BorderThickness="1" Background="{DynamicResource card}" BorderBrush="{DynamicResource border}">
       <Grid><local:PointerLight/><ContentPresenter Margin="8,3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Face" Property="Background" Value="{DynamicResource selection}"/>
        <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource link}"/>
        <Setter Property="Foreground" Value="{DynamicResource link}"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource muted}"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource ink}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value>
    </Setter>
   </Style>
  </ResourceDictionary>
 </Window.Resources>
 <Grid>
  <Grid x:Name="SettingsPage" Margin="12,4,12,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource SettingsNavWidth}"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Grid.RowSpan="2" Style="{StaticResource SettingsPane}" Background="{DynamicResource card}"/>
   <Border Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource SettingsPane}"/>
   <TabControl x:Name="Pages" Grid.ColumnSpan="3" Foreground="{DynamicResource ink}" ItemContainerStyle="{StaticResource SettingsTab}" TabStripPlacement="Left" SelectionChanged="PageChanged" AutomationProperties.Name="{i18n:Tr '设置分类'}">
    <TabControl.Template><ControlTemplate TargetType="TabControl">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource SettingsNavWidth}"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
       <StackPanel Margin="6,5" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once"/>
      </ScrollViewer>
      <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="2" Margin="13,12,13,0" ContentSource="SelectedContent"/>
     </Grid>
    </ControlTemplate></TabControl.Template>
    <TabItem x:Name="GeneralTab" Header="{i18n:Tr '通用'}" Tag="{StaticResource sc-settings}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{i18n:Tr '语言'}"/>
      <Border Style="{StaticResource SettingsCard}"><StackPanel><DockPanel>
       <ComboBox x:Name="InterfaceLanguage" DockPanel.Dock="Right" Width="150" SelectedValuePath="Tag" AutomationProperties.Name="{i18n:Tr '界面语言'}">
        <ComboBoxItem Tag="zh-CN" Content="简体中文"/><ComboBoxItem Tag="en" Content="English"/>
       </ComboBox><TextBlock VerticalAlignment="Center" Text="{i18n:Tr '界面语言'}"/>
      </DockPanel><TextBlock Margin="0,9,0,0" Foreground="{DynamicResource muted}" FontSize="12" TextWrapping="Wrap" Text="{i18n:Tr '保存后，下次启动 FrameNote 或 Player 时生效。'}"/></StackPanel></Border>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{i18n:Tr '文件关联'}"/>
      <Border Style="{StaticResource SettingsCard}"><DockPanel><Button DockPanel.Dock="Right" Content="{i18n:Tr '打开默认应用设置'}" Click="OpenDefaultApps"/><TextBlock VerticalAlignment="Center" Text="{i18n:Tr '默认应用'}"/></DockPanel></Border>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{i18n:Tr '距离标尺'}"/>
      <Border Style="{StaticResource SettingsCard}"><StackPanel><DockPanel>
       <ComboBox x:Name="DefaultRulerUnit" DockPanel.Dock="Right" MinWidth="120" SelectedValuePath="Tag" AutomationProperties.Name="{i18n:Tr '标尺默认单位'}">
        <ComboBoxItem Tag="mm" Content="{i18n:Tr '毫米（mm）'}"/><ComboBoxItem Tag="cm" Content="{i18n:Tr '厘米（cm）'}"/><ComboBoxItem Tag="m" Content="{i18n:Tr '米（m）'}"/><ComboBoxItem Tag="px" Content="{i18n:Tr '像素（px）'}"/>
       </ComboBox><TextBlock VerticalAlignment="Center" Text="{i18n:Tr '标尺默认单位'}"/>
      </DockPanel><TextBlock Margin="0,9,0,0" Foreground="{DynamicResource muted}" FontSize="12" TextWrapping="Wrap" Text="{i18n:Tr '未标定的标尺按 96 px 等于 25.4 mm 换算。'}"/></StackPanel></Border>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{i18n:Tr '导出路径'}"/>
      <Border Style="{StaticResource SettingsCard}"><DockPanel>
       <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{i18n:Tr '浏览…'}" Tag="{Binding ElementName=ExportDirectory}" Click="ChooseDirectory"/>
       <TextBox x:Name="ExportDirectory" Style="{StaticResource DirectoryField}" AutomationProperties.Name="{i18n:Tr '导出路径'}"/>
      </DockPanel></Border>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{i18n:Tr 'MP4 导出'}"/>
      <Border Style="{StaticResource SettingsCard}"><StackPanel>
       <CheckBox x:Name="ExportBarEnabled" Content="{i18n:Tr '显示批注进度条'}"/>
       <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding IsChecked,ElementName=ExportBarEnabled}">
        <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
         <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{i18n:Tr '背景色'}"/>
         <Button x:Name="ExportBarBackground" Click="ChooseBarColor" AutomationProperties.Name="{i18n:Tr '背景色'}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
         <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{i18n:Tr '进度色'}"/>
         <Button x:Name="ExportBarFill" Click="ChooseBarColor" AutomationProperties.Name="{i18n:Tr '进度色'}"/>
        </StackPanel>
       </WrapPanel>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem x:Name="RecordingTab" Header="{i18n:Tr '录制设置'}" Tag="{StaticResource sc-record}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <Border Style="{StaticResource SettingsCard}"><DockPanel>
       <ComboBox x:Name="RecordingFps" DockPanel.Dock="Right" Width="120" SelectedValuePath="Tag" AutomationProperties.Name="{i18n:Tr '帧率'}">
        <ComboBoxItem Content="30 fps" Tag="30"/><ComboBoxItem Content="60 fps" Tag="60"/>
       </ComboBox><TextBlock VerticalAlignment="Center" Text="{i18n:Tr '帧率'}"/>
      </DockPanel></Border>
      <Border Style="{StaticResource SettingsCard}"><DockPanel>
       <ComboBox x:Name="RecordingQuality" DockPanel.Dock="Right" Width="120" SelectedValuePath="Tag" AutomationProperties.Name="{i18n:Tr '压缩品质'}">
        <ComboBoxItem Content="{i18n:Tr '均衡'}" Tag="balanced"/><ComboBoxItem Content="{i18n:Tr '高画质'}" Tag="high"/>
       </ComboBox><TextBlock VerticalAlignment="Center" Text="{i18n:Tr '压缩品质'}"/>
      </DockPanel></Border>
      <Border Style="{StaticResource SettingsCard}"><CheckBox x:Name="SaveCopy" Content="{i18n:Tr '保存副本'}"/></Border>
      <Border Style="{StaticResource SettingsCard}" IsEnabled="{Binding IsChecked,ElementName=SaveCopy}"><StackPanel>
       <TextBlock Margin="0,0,0,8" Text="{i18n:Tr '副本保存路径'}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource disabled}"/></Trigger>
       </Style.Triggers></Style></TextBlock.Style></TextBlock>
       <DockPanel><Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{i18n:Tr '浏览…'}" Tag="{Binding ElementName=CopyDirectory}" Click="ChooseDirectory"/>
        <TextBox x:Name="CopyDirectory" Style="{StaticResource DirectoryField}" AutomationProperties.Name="{i18n:Tr '副本保存路径'}"/>
       </DockPanel>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem x:Name="ExcelTab" Header="{i18n:Tr '表格设置'}" Tag="{StaticResource sc-table}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{i18n:Tr '工作表内容'}"/>
      <Border Style="{StaticResource SettingsCard}"><StackPanel>
       <CheckBox x:Name="ExcelShowSource" Content="{i18n:Tr '在表头显示源文件名'}"/>
       <Border Height="1" Background="{DynamicResource edge}" Margin="0,12"/>
       <TextBlock Text="{i18n:Tr '导出列'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
       <UniformGrid x:Name="ExcelColumnChoices" Columns="2"/>
       <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource muted}" FontSize="12" TextWrapping="Wrap"
        Text="{i18n:Tr '画面预览嵌入工作簿。媒体文件列链接到点批注的 PNG 或区间批注的 GIF。'}"/>
      </StackPanel></Border>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{i18n:Tr '交付方式'}"/>
      <Border Style="{StaticResource SettingsCard}"><StackPanel>
       <CheckBox x:Name="ExcelZip" Content="{i18n:Tr '导出为 ZIP 压缩包'}"/>
       <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource muted}" FontSize="12" TextWrapping="Wrap"
        Text="{i18n:Tr '将工作簿和所选媒体一起打包。接收方解压后即可打开表格中的媒体链接。'}"/>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem x:Name="ShortcutsTab" Header="{i18n:Tr '快捷键'}" Tag="{StaticResource sc-keyboard}">
     <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="0,0,4,4">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="ShortcutSearch" Style="{StaticResource DirectoryField}" AutomationProperties.Name="{i18n:Tr '搜索快捷键'}"
                TextChanged="SearchTextChanged" PreviewKeyDown="SearchKeyDown" PreviewMouseDown="SearchMouseDown" PreviewMouseWheel="SearchWheel"/>
       <TextBlock x:Name="SearchHint" IsHitTestVisible="False" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                  Foreground="{DynamicResource muted}" Text="{i18n:Tr '输入操作名称'}"/>
       <Button x:Name="ClearSearch" Grid.Column="1" Style="{StaticResource SettingsIconButton}" Margin="4,0,0,0" Visibility="Collapsed"
               ToolTip="{i18n:Tr '清除搜索'}" AutomationProperties.Name="{i18n:Tr '清除搜索'}" Click="ClearShortcutSearch"/>
       <CheckBox x:Name="FindByKey" Grid.Column="2" Style="{StaticResource ModifierChip}" Margin="6,0,0,0" Checked="ChangeSearchMode" Unchecked="ChangeSearchMode"
                 AutomationProperties.Name="{i18n:Tr '按键查找'}">
        <StackPanel Orientation="Horizontal"><ContentControl x:Name="FindKeyIcon" Margin="0,0,5,0"/><TextBlock Text="{i18n:Tr '按键查找'}"/></StackPanel>
       </CheckBox>
      </Grid>
      <Grid>
       <ScrollViewer x:Name="ShortcutList" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Groups"/></ScrollViewer>
       <TextBlock x:Name="NoSearchResults" Text="{i18n:Tr '没有匹配的操作'}" Foreground="{DynamicResource muted}"
                  Margin="8,16" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/>
      </Grid>
     </DockPanel>
    </TabItem>
    <TabItem x:Name="GuideTab" Header="{i18n:Tr '使用说明'}" Tag="{StaticResource sc-book}">
     <ScrollViewer x:Name="GuideScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,6,0">
       <Border Style="{StaticResource SettingsCard}"><StackPanel>
        <TextBlock x:Name="GuideOverviewTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/>
        <TextBlock x:Name="GuideOverviewText" Foreground="{DynamicResource muted}" Margin="0,6,0,0" LineHeight="21" TextWrapping="Wrap"/>
       </StackPanel></Border>
       <ItemsControl x:Name="GuideSections" Focusable="False">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Style="{StaticResource SettingsCard}"><StackPanel>
          <DockPanel>
           <Viewbox Width="17" Height="17" Margin="0,0,8,0">
            <Canvas Width="24" Height="24"><Path Data="{Binding Icon}" Stroke="{DynamicResource link}" StrokeThickness="1.8"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas>
           </Viewbox>
           <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Topics}" Focusable="False">
           <ItemsControl.ItemTemplate><DataTemplate>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="21" FontSize="13" Foreground="{DynamicResource muted}">
             <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource ink}"/><Run Text="  "/><Run Text="{Binding Text, Mode=OneWay}"/>
            </TextBlock>
           </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel></Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem x:Name="UpdatesTab" Header="{i18n:Tr '更新'}" Tag="{StaticResource sc-update}">
     <ScrollViewer x:Name="UpdatesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="ResizeUpdates">
      <DockPanel x:Name="UpdatesContent">
      <StackPanel DockPanel.Dock="Top">
       <Border Style="{StaticResource SettingsCard}"><StackPanel>
        <DockPanel>
         <Button x:Name="CheckButton" DockPanel.Dock="Right" Content="{i18n:Tr '检查更新'}" Click="CheckVersion"/>
         <TextBlock x:Name="CurrentVersion" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="UpdateHint" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource muted}" TextWrapping="Wrap"
                   Text="{i18n:Tr '温馨提示：更新来自 GitHub。部分网络可能遇到 DNS 解析问题，如果检查或下载失败，可以稍后重试。'}"/>
       </StackPanel></Border>
       <Border Style="{StaticResource SettingsCard}" MinHeight="59">
        <CheckBox x:Name="AutomaticUpdates" Content="{i18n:Tr '启动时检查更新'}"/>
       </Border>
      </StackPanel>
      <Border Style="{StaticResource SettingsCard}" Margin="0">
       <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{i18n:Tr '更新记录'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.HeadingLevel="Level2"/>
        <ComboBox DockPanel.Dock="Top" x:Name="ReleaseVersions" Margin="0,0,0,10" AutomationProperties.Name="{i18n:Tr '更新记录版本'}"/>
        <ScrollViewer x:Name="ReleaseScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{i18n:Tr '更新记录正文'}">
         <ItemsControl x:Name="ReleaseText" ItemTemplate="{StaticResource ReleaseEntry}" Margin="0,0,8,0"
                       AutomationProperties.Name="{i18n:Tr '更新记录正文'}"/>
        </ScrollViewer>
       </DockPanel>
      </Border>
      </DockPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="{i18n:Tr '问题反馈'}" Tag="{StaticResource sc-feedback}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <Border Style="{StaticResource SettingsCard}">
       <DockPanel>
        <Path DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center" Stretch="Uniform"
              Fill="{DynamicResource ink}" Data="{StaticResource github-mark}"/>
        <Button x:Name="IssueButton" DockPanel.Dock="Right" Content="{i18n:Tr '前往 GitHub'}" Margin="10,0,0,0" VerticalAlignment="Center" Click="OpenFeedbackTarget"/>
        <StackPanel VerticalAlignment="Center">
         <TextBlock Text="GitHub Issues" FontWeight="SemiBold"/>
         <TextBlock Text="{i18n:Tr '点击前往 GitHub Issues 界面提交问题。'}" FontSize="13" Foreground="{DynamicResource muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Border Style="{StaticResource SettingsCard}"><DockPanel>
       <Button DockPanel.Dock="Right" Content="{i18n:Tr '打开日志目录'}" Click="OpenFeedbackTarget"/>
       <TextBlock Text="{i18n:Tr '运行日志'}" VerticalAlignment="Center"/>
      </DockPanel></Border>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem x:Name="AboutTab" Header="{i18n:Tr '关于'}" Tag="{StaticResource sc-info}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <DockPanel Margin="4,4,4,14">
       <Image x:Name="AboutIcon" DockPanel.Dock="Left" Width="56" Height="56"
              VerticalAlignment="Center" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="FrameNote" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
        <TextBlock x:Name="AboutDescription" Foreground="{DynamicResource muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
        <WrapPanel Margin="0,4,0,0" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource muted}">
         <TextBlock x:Name="AboutVersion" Margin="0,0,12,0"/><TextBlock x:Name="AboutAuthor"/>
        </WrapPanel>
       </StackPanel>
      </DockPanel>
      <Border Height="1" Background="{DynamicResource edge}" Margin="0,0,0,12"/>
      <Button x:Name="HomeButton" Click="OpenHome" HorizontalContentAlignment="Stretch" Padding="14,10"
              Background="{DynamicResource panel}" BorderBrush="{DynamicResource edge}" AutomationProperties.Name="{i18n:Tr 'Github主页'}">
       <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
         <TextBlock Text="github.com" Foreground="{DynamicResource link}" FontSize="13"/>
         <Viewbox Width="14" Height="14" Margin="5,0,0,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource sc-externalLink}" Stroke="{DynamicResource link}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
        </StackPanel>
        <StackPanel>
         <TextBlock Text="{i18n:Tr 'Github主页'}" FontWeight="SemiBold"/>
         <TextBlock Text="{i18n:Tr '查看 FrameNote 的项目介绍、源代码和最新版本。'}" FontSize="13" Margin="0,3,0,0" Foreground="{DynamicResource muted}" TextWrapping="Wrap"/>
        </StackPanel>
       </DockPanel>
      </Button>
     </StackPanel></ScrollViewer>
    </TabItem>
   </TabControl>
   <StackPanel Grid.Column="2" Grid.Row="1" Margin="13,12,13,12">
    <TextBlock x:Name="SaveError" Margin="0,0,0,6" Foreground="{DynamicResource danger}" TextWrapping="Wrap" Visibility="Collapsed"/>
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Background="Transparent">
      <Button Content="{i18n:Tr '取消'}" MinWidth="64" Margin="0,0,6,0" Click="CancelSettings"/>
      <Button Content="{i18n:Tr '保存'}" MinWidth="64" Click="SaveSettings"/>
     </StackPanel>
     <Button x:Name="ResetButton" Content="{i18n:Tr '恢复本页默认值'}" HorizontalAlignment="Left" Click="ResetPage"/>
    </DockPanel>
   </StackPanel>
  </Grid>
  <Grid x:Name="Overlay" Visibility="Collapsed" Background="#99000000" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
   <Border MaxWidth="460" VerticalAlignment="Center" Margin="20" Padding="18,15" CornerRadius="{StaticResource PaneCorners}"
    Background="{DynamicResource panel}" BorderBrush="{DynamicResource border}" BorderThickness="1">
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button x:Name="CloseEditorButton" DockPanel.Dock="Right" Style="{StaticResource SettingsIconButton}" ToolTip="{i18n:Tr '关闭'}" AutomationProperties.Name="{i18n:Tr '关闭配置'}" Click="CancelEditor"/>
      <TextBlock x:Name="EditorTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
     </DockPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <TextBlock x:Name="EditorError" Foreground="{DynamicResource danger}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
       <Button Content="{i18n:Tr '取消'}" AutomationProperties.AutomationId="cancelBinding" Width="64" Margin="0,0,6,0" Click="CancelEditor"/>
       <Button x:Name="ApplyBinding" Content="{i18n:Tr '确定'}" Width="72" Background="{DynamicResource selection}" BorderBrush="{DynamicResource link}" Click="ConfirmEditor"/>
      </StackPanel>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <StackPanel x:Name="BindingRows"/>
       <StackPanel x:Name="GestureOptions" Visibility="Collapsed" Margin="0,4,0,10">
        <TextBlock Text="{i18n:Tr '修饰键'}" Foreground="{DynamicResource muted}" Margin="0,0,0,5"/>
        <StackPanel x:Name="ModifierChoices" Orientation="Horizontal"/>
        <TextBlock x:Name="GestureCaption" Text="{i18n:Tr '鼠标操作'}" Foreground="{DynamicResource muted}" Margin="0,9,0,5"/>
        <ComboBox x:Name="MouseChoice" SelectionChanged="GestureChanged" AutomationProperties.Name="{i18n:Tr '鼠标操作'}"/>
       </StackPanel>
       <Button x:Name="AddBinding" Click="AddKey" AutomationProperties.Name="{i18n:Tr '添加快捷键'}">
        <StackPanel Orientation="Horizontal"><ContentControl x:Name="PlusIcon" Margin="0,0,6,0"/><TextBlock Text="{i18n:Tr '添加快捷键'}"/></StackPanel>
       </Button>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
